{
  "name": "h3-compression",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@12.23.0",
  "description": "Adds compression to h3 request (brotli, gzip, deflate, zstd)",
  "author": {
    "name": "Gregor Becker",
    "email": "gregor@codedredd.de"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/codedredd",
  "homepage": "https://github.com/CodeDredd/h3-compression#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeDredd/h3-compression.git"
  },
  "bugs": "https://github.com/CodeDredd/h3-compression/issues",
  "keywords": [
    "h3",
    "h3-compression",
    "gzip",
    "brotli",
    "deflate",
    "zstd",
    "compression"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs"
    },
    "./nuxt-runtime": {
      "types": "./dist/runtime/nitro-plugin.d.ts",
      "import": "./dist/runtime/nitro-plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "test:types": "vitest --typecheck.only --run",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "h3": "^1.6.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@antfu/ni": "^30.6.0",
    "@nuxt/kit": "^4.7.0",
    "@nuxt/schema": "4.7.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "esno": "^4.8.0",
    "h3": "2.0.8",
    "lint-staged": "^17.6.2",
    "node-fetch-native": "^1.6.7",
    "rollup": "4.68.8",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
